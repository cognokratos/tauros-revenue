<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="px-4 py-10 sm:px-6 sm:py-28 lg:px-8 xl:px-28 xl:py-32">
    <div class="mx-auto max-w-7xl">
      <div class="flex justify-between items-center mb-10">
        <h1 class="text-3xl font-bold leading-9 tracking-tight">Dashboard</h1>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <.card>
          <.link navigate={~p"/agents"} class="block px-6 py-4 hover:bg-blue-50 transition-colors">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-medium text-gray-600">Agents</p>
                <p class="mt-2 text-3xl font-bold text-blue-900">{@agents_count}</p>
              </div>
              <.icon name="hero-user-group" class="w-8 h-8 text-blue-400" />
            </div>
          </.link>
        </.card>

        <.card>
          <a href="#" class="block px-6 py-4 hover:bg-green-50 transition-colors">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-medium text-gray-600">Clients</p>
                <p class="mt-2 text-3xl font-bold text-green-900">{@clients_count}</p>
              </div>
              <.icon name="hero-building-storefront" class="w-8 h-8 text-green-400" />
            </div>
          </a>
        </.card>

        <.card>
          <a href="#" class="block px-6 py-4 hover:bg-yellow-50 transition-colors">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-medium text-gray-600">Pending Invoices</p>
                <p class="mt-2 text-3xl font-bold text-yellow-900">{@pending_invoices_count}</p>
              </div>
              <.icon name="hero-document-text" class="w-8 h-8 text-yellow-400" />
            </div>
          </a>
        </.card>

        <.card>
          <a href="#" class="block px-6 py-4 hover:bg-green-50 transition-colors">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-sm font-medium text-gray-600">Approved Invoices</p>
                <p class="mt-2 text-3xl font-bold text-green-900">{@approved_invoices_count}</p>
              </div>
              <.icon name="hero-check-circle" class="w-8 h-8 text-green-400" />
            </div>
          </a>
        </.card>
      </div>
    </div>
  </div>
</Layouts.app>
